# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/

# Build binaries (too large for git) — but keep the doc explaining what
# goes here, since the binaries themselves are never committed. Excluding
# via build/bin/* (not build/bin/) so the !negation below can still reach
# inside the directory — git can't re-include a file whose parent directory
# itself was excluded, only files matched individually.
build/bin/*
build/bin/win/
!build/bin/README.md

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Electron
out/
app/
*.asar

# Temporary files
*.tmp
*.temp

# Python (key detection venv)
.venv/
**/.venv/
__pycache__/
*.pyc

