{
  "name": "@ilovemusic/engine",
  "version": "0.1.0",
  "description": "Platform-agnostic download + audio processing engine (Spotify/SoundCloud/Bandcamp, BPM/key detection, metadata embedding). Consumed by the Electron desktop app and the public API.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "music-metadata": "^11.10.3",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "vitest": "^2.1.8"
  }
}
