# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Database (Postgres — Neon in production, docker-compose locally) ---
# Local (docker-compose up): postgresql://ilovemusic:ilovemusic@localhost:5432/ilovemusic?sslmode=disable
# Neon: get the pooled connection string from the Neon dashboard (includes sslmode=require)
DATABASE_URL=postgresql://ilovemusic:ilovemusic@localhost:5432/ilovemusic?sslmode=disable

# --- Redis (BullMQ job queue + rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- BYOK credential encryption ---
# Encrypts each API consumer's own Spotify Developer App credentials at rest
# (see routes/spotifyCredentials.ts) — the platform holds no Spotify app of
# its own. 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes all previously-registered credentials
# undecryptable — every user would need to re-register.
CREDENTIALS_ENCRYPTION_KEY=

# --- Cloudflare R2 (S3-compatible object storage for finished downloads) ---
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ilovemusic-downloads

# How long a presigned download URL stays valid once minted (seconds)
DOWNLOAD_URL_TTL_SECONDS=3600

# --- Rate limiting (per API key, falls back to IP if unauthenticated) ---
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute

# --- Worker ---
# Local scratch dir for in-flight downloads before upload to R2 (auto-cleaned per job)
WORK_DIR=
WORKER_CONCURRENCY=2
