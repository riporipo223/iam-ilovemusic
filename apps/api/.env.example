# Every variable below is required at boot (assertRuntimeConfig() in
# src/config.ts fails fast and loudly if any is missing) EXCEPT the ones
# explicitly marked optional. Server and worker both read this same set —
# see DEPLOYMENT.md for which vars each process actually needs at runtime
# (server never touches R2/download-tool vars directly except to read them,
# worker needs everything).
#
# [SECRET] = never commit a real value, never log it, treat like a password.
# [PUBLIC] = safe to see in a build log, screenshot, or CI config — not
#            sensitive on its own.

# --- Server (worker doesn't use these — no HTTP server there) ---
PORT=3000                    # [PUBLIC]
HOST=0.0.0.0                 # [PUBLIC]
NODE_ENV=production          # [PUBLIC] — also switches Fastify's logger to raw JSON (see server.ts)

# --- Database (Postgres — Neon in production, docker-compose locally) ---
# Local (docker-compose up): postgresql://ilovemusic:ilovemusic@localhost:5432/ilovemusic?sslmode=disable
# Neon: get the pooled connection string from the Neon dashboard (includes sslmode=require)
DATABASE_URL=postgresql://ilovemusic:ilovemusic@localhost:5432/ilovemusic?sslmode=disable
# [SECRET] — contains a password even for a "read" connection string.

# --- Redis (BullMQ job queue + rate limiting) ---
REDIS_URL=redis://localhost:6379
# [SECRET] if the managed provider's URL embeds a password (most do, e.g.
# Upstash) — treat as secret even though the bare local dev value above isn't.

# --- BYOK credential encryption ---
# Encrypts each API consumer's own Spotify Developer App credentials at rest
# (see routes/spotifyCredentials.ts) — the platform holds no Spotify app of
# its own. 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes all previously-registered credentials
# undecryptable — every user would need to re-register.
CREDENTIALS_ENCRYPTION_KEY=
# [SECRET] — arguably the most sensitive value here. Anyone with this key
# plus DB access can decrypt every registered Spotify credential.

# --- Platform Spotify credentials (NOT BYOK) ---
# Back GET /v1/spotify-metadata specifically — a proxy the ILoveMusic
# desktop app calls so it never has to hold a Spotify Client Secret locally
# (previously bundled in the packaged .dmg, which is extractable from its
# asar). These belong to the platform operator (the desktop app's own
# developer), not an API consumer — deliberately separate from the BYOK
# credentials above, which are per-consumer and stored encrypted in the DB.
# Optional — the server boots fine without these; only this one endpoint
# returns 500 until they're set. Get them from
# https://developer.spotify.com/dashboard, same as any BYOK credential.
PLATFORM_SPOTIFY_CLIENT_ID= 
# [PUBLIC] — a client ID alone isn't sensitive, but there's no reason to
# expose it either.
PLATFORM_SPOTIFY_CLIENT_SECRET=
# [SECRET]

# --- Cloudflare R2 (S3-compatible object storage for finished downloads) ---
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# [PUBLIC] — an endpoint URL, not a credential on its own.
R2_ACCESS_KEY_ID=
# [SECRET] (paired with the secret key below — an access key ID alone is
# low-value, but treat it as secret anyway; no reason to expose it).
R2_SECRET_ACCESS_KEY=
# [SECRET]
R2_BUCKET=ilovemusic-downloads
# [PUBLIC]

# How long a presigned download URL stays valid once minted (seconds)
DOWNLOAD_URL_TTL_SECONDS=3600
# [PUBLIC]

# --- Rate limiting (per API key, falls back to IP if unauthenticated) ---
RATE_LIMIT_MAX=20            # [PUBLIC]
RATE_LIMIT_WINDOW=1 minute   # [PUBLIC]

# --- Worker only ---
# Local scratch dir for in-flight downloads before upload to R2 (auto-cleaned
# per job). Optional — defaults to a subdirectory of the OS temp dir. If the
# platform's default /tmp is small (some PaaS tmpfs defaults are ~64MB) and
# WORKER_CONCURRENCY is raised, point this at a mounted volume instead.
WORK_DIR=
# [PUBLIC] — a filesystem path, not a credential.
WORKER_CONCURRENCY=2
# [PUBLIC]

# --- Binary overrides (optional, worker only) ---
# Not needed if the worker image's PATH already has spotdl/yt-dlp/ffmpeg/
# aubio/python3 on it (the provided Dockerfile's `worker` target does this
# via a venv on PATH — see apps/api/Dockerfile). Only set these if binaries
# live somewhere PATH won't find, e.g. a custom base image layout.
#
# SPOTDL_PATH in particular is worth setting explicitly even when a system
# spotdl is on PATH: an old/deprecated Python running it (e.g. Python 3.9)
# can make every single Spotify download fail with no obvious error — yt-dlp
# logs its own "deprecated Python version" notice as an error, and spotdl's
# error handling turns that into a raised exception unconditionally. Check
# spotdl's actual supported range before picking a venv Python version
# (`Requires-Python` on PyPI), don't assume the same version as any other
# Python venv this project uses is fine. See apps/api/DEPLOYMENT.md's
# "spotdl and quickjs" section for the dedicated-venv setup this was fixed
# with on the self-hosted deployment.
# SPOTDL_PATH=
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=
# AUBIO_PATH=
# PYTHON_PATH=
# QUICKJS_PATH=
# [PUBLIC] — filesystem paths, not credentials.
