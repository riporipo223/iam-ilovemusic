<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ACTIVE — this is the named tunnel variant, self-hosting apps/api at
  api.madebyripo.sbs (domain on Hostinger, DNS/tunnel routing on
  Cloudflare). Quick tunnel (random *.trycloudflare.com URL, no domain
  needed) is now the fallback/emergency option if this one has trouble —
  see ../cloudflared/config.named-tunnel.yml.example (kept as a
  template/reference, not loaded) and DEPLOYMENT.md's "Self-Hosting via
  Cloudflare Tunnel" section
  for how to switch back to it temporarily.

  Points --config at ../cloudflared/config.yml — the filled-in file with
  the real tunnel ID and hostname, NOT
  ../cloudflared/config.named-tunnel.yml.example (that's the placeholder
  template this file's config was originally copied from; pointing here at
  the .example by mistake is exactly what broke this tunnel once already —
  cloudflared fails outright with "Tunnel credentials file
  '.../<TUNNEL_ID>.json' doesn't exist", since that literal string is never
  a real path).

  Runs the Cloudflare Tunnel as a macOS user LaunchAgent, so the API stays
  publicly reachable across reboots without you opening a terminal.

  Requires cloudflared installed and the tunnel already created (see
  ../cloudflared/config.yml's header comment, or DEPLOYMENT.md) — this
  plist doesn't do either of those, it only keeps an already-configured
  tunnel running.

  The cloudflared path below (/opt/homebrew/bin) matches this machine's
  actual Homebrew prefix (Apple Silicon default) — confirmed via `which
  cloudflared` after install, not guessed. Re-verify if you're setting
  this up on a different Mac.

  Install / reload:
    launchctl unload ~/Library/LaunchAgents/com.ilovemusic.cloudflared.plist 2>/dev/null
    cp apps/api/launchd/com.ilovemusic.cloudflared.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.ilovemusic.cloudflared.plist

  Logs: ~/Library/Logs/ilovemusic-cloudflared.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ilovemusic.cloudflared</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/Users/ripo/2. PROJECT/ILoveMusic/apps/api/cloudflared/config.yml</string>
    <string>run</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/ripo/Library/Logs/ilovemusic-cloudflared.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ripo/Library/Logs/ilovemusic-cloudflared.log</string>
</dict>
</plist>
