# Standalone (no build --target needed) equivalent of the `server` stage in
# ./Dockerfile. Exists specifically for platforms whose build config can't
# select a multi-stage target — confirmed Render's Blueprint spec has no
# such field (no `dockerTarget` or equivalent as of this writing). If your
# platform DOES support `docker build --target`, prefer the combined
# ./Dockerfile instead — this file duplicates its early stages, so keep the
# two in sync if you change deps/build steps.
#
# Build from the MONOREPO ROOT (apps/api depends on the @ilovemusic/engine
# workspace package, which needs the root package.json/lockfile to resolve):
#
#   docker build -f apps/api/Dockerfile.server -t ilovemusic-api-server .
#
# Deliberately minimal — never shells out to spotdl/yt-dlp/ffmpeg/aubio/
# python3, so none of that is installed here (see Dockerfile.worker for the
# image that needs it).

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/engine/package.json packages/engine/package.json
COPY apps/api/package.json apps/api/package.json
RUN npm ci

FROM deps AS build
COPY packages/engine packages/engine
COPY apps/api apps/api
RUN npm run build --workspace @ilovemusic/engine \
 && npm run build --workspace @ilovemusic/api \
 && npm prune --omit=dev

FROM node:22-bookworm-slim AS server
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/engine/dist ./packages/engine/dist
COPY --from=build /app/packages/engine/scripts ./packages/engine/scripts
COPY --from=build /app/packages/engine/package.json ./packages/engine/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/server.js"]
