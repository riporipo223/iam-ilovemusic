{
  "name": "@ilovemusic/cli",
  "version": "0.1.0",
  "description": "Interactive command-line client for the ILoveMusic public API — download tracks from Spotify, SoundCloud, and Bandcamp without touching curl, HTTP, or job polling directly.",
  "type": "module",
  "bin": {
    "ilovemusic": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:e2e": "tsx scripts/verify-e2e.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "music-metadata": "^11.10.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
