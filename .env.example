# Where this file needs to live depends on how you're running the app:
#   - `npm run dev` / `electron .`  → project root (next to this file), as usual.
#   - a packaged, installed .app     → ~/Library/Application Support/ilovemusic-desktop/.env
#     (macOS; not created automatically — copy it there yourself. Note the
#     folder is "ilovemusic-desktop", from package.json's "name" — NOT
#     "ILoveMusic", even though that's the app/DMG's display name). A
#     packaged build never reads the project root's .env at all, and .env is
#     never bundled into the app itself. Sanity-check either mode without
#     opening the app: `npm run verify:env` (dev) / `npm run verify:env:packaged`.
#
# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
# Create an app and copy the Client ID and Client Secret
#
# NOTE: single-Spotify-track downloads (pasting a Spotify track URL) no
# longer use these directly — that flow now fetches metadata via the
# ILoveMusic API's GET /v1/spotify-metadata proxy instead (see the two vars
# below), so the app never holds a Spotify Client Secret locally. These
# vars are still required for two other things that weren't changed:
# the SoundCloud/Bandcamp BPM/key cross-reference fallback (getBpmKeyFromSpotify)
# and Spotify album downloads (download-spotify-album).

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ILoveMusic API — self-hosted proxy for single-track Spotify metadata
# (see apps/api's GET /v1/spotify-metadata and main.js's
# fetchSpotifyMetadataViaProxy()). Required for Spotify track downloads.
#
# ILOVEMUSIC_API_BASE_URL: the server's current base URL. If it's running
# behind a Cloudflare Quick Tunnel (see apps/api/DEPLOYMENT.md), this
# changes on every reconnect — check apps/api/scripts/get-tunnel-url.sh for
# the current one rather than assuming it's stable.
# ILOVEMUSIC_API_KEY: an API key issued for this desktop app specifically
# (apps/api/scripts/create-api-key) — separate from any key used for manual
# API testing, so it can be revoked independently.
ILOVEMUSIC_API_BASE_URL=https://your-current-tunnel-url.trycloudflare.com
ILOVEMUSIC_API_KEY=your_desktop_app_api_key_here
